PREFIX r:    <https://example.org/regiostar/resource/>
PREFIX o:    <https://example.org/regiostar/ontology/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>

CONSTRUCT {
  ?schemeResource
    a skos:ConceptScheme, o:RegioStaRScheme ;
    dct:identifier ?schemeCode ;
    skos:notation ?schemeCode ;
    skos:prefLabel ?schemeLabelDe ;
    skos:hasTopConcept ?concept ;
    rdfs:label ?schemeLabelDe ;
    .

  ?concept
    a skos:Concept, o:RegioStaRType ;
    dct:identifier ?identifier ;
    skos:notation ?code ;
    skos:prefLabel ?labelDe ;
    skos:inScheme ?schemeResource ;
    skos:topConceptOf ?schemeResource ;
    rdfs:label ?labelDe ;
    .
}
WHERE {
  BIND(STRLANG(?label_de, "de") AS ?labelDe)
  BIND(CONCAT(?scheme, ":", ?code) AS ?identifier)

  BIND(IRI(CONCAT(STR(r:), "scheme/", ENCODE_FOR_URI(?scheme))) AS ?schemeResource)
  BIND(IRI(CONCAT(STR(r:), "concept/", ENCODE_FOR_URI(?scheme), "/", ENCODE_FOR_URI(?code))) AS ?concept)

  BIND(STRLANG(?scheme, "de") AS ?schemeLabelDe)
}

