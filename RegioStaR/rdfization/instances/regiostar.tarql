PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

PREFIX ex:   <https://example.org/vocab/>
PREFIX id:   <https://example.org/id/>
PREFIX rs:   <https://example.org/id/regiostar/>

CONSTRUCT {
  ?municipality
    a geo:Feature ;
    dct:identifier ?ags_0 ;
    skos:prefLabel ?municipalityLabel ;
    ex:regionalKey ?regionalKey ;
    ex:nutsRegion ?nutsRegion ;

    ex:regioStaR2 ?RegioStaR2_iri ;
    ex:regioStaR4 ?RegioStaR4_iri ;
    ex:regioStaR17 ?RegioStaR17_iri ;
    ex:regioStaR7 ?RegioStaR7_iri ;
    ex:regioStaR5 ?RegioStaR5_iri ;
    ex:regioStaRGem7 ?RegioStaRGem7_iri ;
    ex:regioStaRGem5 ?RegioStaRGem5_iri ;

    geo:hasGeometry ?geometryResource .

  ?geometryResource
    a geo:Geometry ;
    dct:identifier ?objid ;
    geo:asWKT ?geometryLiteral .
}
WHERE {
  #BIND(<http://www.example.org/foobar> AS ?municipality)

  # You can derive the AGS from GEMRS_21 by keeping the first five and last three characters:
  BIND(CONCAT(SUBSTR(STR(?gemrs_21), 1, 5), SUBSTR(STR(?gemrs_21), 10, 3)) AS ?ags) 

  # BIND(IRI(CONCAT("https://example.org/id/municipality/", ?ags_0)) AS ?municipality)
  BIND(IRI(CONCAT("https://example.org/id/municipality/", ?gemrs_21)) AS ?municipality)

  BIND(STRLANG(?name_21, "de") AS ?municipalityLabel)
  BIND(IRI(CONCAT("http://dcat-ap.de/def/politicalGeocoding/regionalKey/", ?ars_0)) AS ?regionalKey)

  #BIND(IRI(CONCAT("http://dcat-ap.de/def/politicalGeocoding/regionalKey/", ?gemrs_21)) AS ?regionalKey)
  #BIND(IRI(CONCAT("https://data.europa.eu/nuts/code/", ?nuts)) AS ?nutsRegion)
  
  BIND(IRI(CONCAT("https://example.org/id/regiostar/RegioStaR2/", ?RegioStaR2)) AS ?RegioStaR2_iri)
  BIND(IRI(CONCAT("https://example.org/id/regiostar/RegioStaR4/", ?RegioStaR4)) AS ?RegioStaR4_iri)
  BIND(IRI(CONCAT("https://example.org/id/regiostar/RegioStaR5/", ?RegioStaR5)) AS ?RegioStaR5_iri)
  BIND(IRI(CONCAT("https://example.org/id/regiostar/RegioStaR7/", ?RegioStaR7)) AS ?RegioStaR7_iri)
  BIND(IRI(CONCAT("https://example.org/id/regiostar/RegioStaR17/", ?RegioStaR17)) AS ?RegioStaR17_iri)

  BIND(IRI(CONCAT("https://example.org/id/regiostar/gem7/", ?RegioStaRGem7)) AS ?RegioStaRGem7_iri)
  BIND(IRI(CONCAT("https://example.org/id/regiostar/gem5/", ?RegioStaRGem5)) AS ?RegioStaRGem5_iri)

  # BIND(IRI(CONCAT("https://example.org/id/geometry/", ENCODE_FOR_URI(?objid))) AS ?geometryResource)

  # Adjust the CRS URI to match the shapefile, or reproject with ogr2ogr.
  # BIND(STRDT(CONCAT("<http://www.opengis.net/def/crs/EPSG/0/25832> ", ?geometry), geo:wktLiteral) AS ?geometryLiteral)
}

